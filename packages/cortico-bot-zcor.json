{
  "schema": 1,
  "name": "cortico-bot-zcor",
  "version": "0.2.1",
  "describe": {
    "tools": [
      {
        "name": "zcor_memory_write",
        "description": "持久化标题和正文；提供已有 id 时更新，否则新增。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "title",
            "content"
          ]
        },
        "tags": [
          "write"
        ],
        "summary": {
          "zh": "新增或更新一条持久化 Memory。",
          "en": "Creates or updates a persistent memory."
        }
      },
      {
        "name": "zcor_memory_read",
        "description": "按 id 读取记忆。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id"
          ]
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "按 id 读取一条 Memory。",
          "en": "Reads one memory by id."
        }
      },
      {
        "name": "zcor_memory_delete",
        "description": "按 id 删除当前记忆；操作历史保留删除前内容。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id"
          ]
        },
        "tags": [
          "write"
        ],
        "summary": {
          "zh": "删除一条 Memory，并保留操作历史。",
          "en": "Deletes a memory while retaining its operation history."
        }
      },
      {
        "name": "zcor_memory_important",
        "description": "标记或取消重要记忆。最多 5 条，超出取消最早标记并返回提醒。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "important": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "important"
          ]
        },
        "tags": [
          "write"
        ],
        "summary": {
          "zh": "标记或取消重要 Memory。",
          "en": "Marks or unmarks an important memory."
        }
      },
      {
        "name": "zcor_memory_query",
        "description": "按更新时间、标题和正文关键词查询当前记忆。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keywords": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "按关键词、时间范围查询当前 Memory。",
          "en": "Queries current memories by keywords and time range."
        }
      },
      {
        "name": "zcor_memory_history",
        "description": "按操作时间和关键词查询记忆操作历史。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keywords": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "按关键词、时间范围查询 Memory 操作历史。",
          "en": "Queries memory operation history by keywords and time range."
        }
      },
      {
        "name": "zcor_memory_backup",
        "description": "将当前 Memory 状态复制为带时间戳的备份文件。",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        },
        "tags": [
          "write"
        ],
        "summary": {
          "zh": "备份 Memory 状态。",
          "en": "Backs up the Memory state."
        }
      },
      {
        "name": "zcor_memory_restore",
        "description": "从指定备份文件恢复 Memory 状态。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backupFile": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "backupFile"
          ]
        },
        "tags": [
          "write"
        ],
        "summary": {
          "zh": "从备份恢复 Memory 状态。",
          "en": "Restores the Memory state from a backup."
        }
      },
      {
        "name": "zcor_synonyms_add",
        "description": "保存一组同义词，查询时双向扩展。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "terms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "terms"
          ]
        },
        "tags": [
          "write"
        ],
        "summary": {
          "zh": "添加同义词组。",
          "en": "Adds a synonym group."
        }
      },
      {
        "name": "zcor_memory_search",
        "description": "关键词经同义词扩展后匹配标题，再由 LLM 从候选正文中选择记忆。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keywords": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "keywords"
          ]
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "先筛选标题候选，再由 LLM 从正文中选择相关 Memory。",
          "en": "Shortlists titles locally, then asks the LLM to select relevant memories from their contents."
        }
      },
      {
        "name": "zcor_end_turn",
        "description": "结束本轮，等待新事件。",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        },
        "tags": [
          "flow"
        ],
        "summary": {
          "zh": "结束本轮。",
          "en": "Ends the current turn."
        }
      }
    ],
    "bot": {
      "worlds": [
        "console"
      ],
      "memory": {
        "name": "Memory",
        "form": {
          "zh": "带版本、重要标记和操作历史的 JSON Memory 状态文件，附件存于 blobs/。",
          "en": "A versioned JSON Memory state with important marks and operation history; attachments live under blobs/."
        }
      }
    }
  },
  "changelog": {
    "0.2.1": "- Declare the `internal-state` market tag for the Persona-owned Memory system.",
    "0.2.0": "- Upgrade the bot extension contract to Cortico 0.2.0.\n- Rename the default built-in World declaration from `terminal` to `console`.\n- Keep structured Memory retrieval, important memories, operation history, backups and restores."
  }
}
