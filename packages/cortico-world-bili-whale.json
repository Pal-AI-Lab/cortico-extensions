          "read"
        ],
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "search",
                "detail"
              ]
            },
            "keyword": {
              "type": "string",
              "description": "Search text"
            },
