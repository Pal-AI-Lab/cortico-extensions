{
  "schema": 1,
  "name": "cortico-world-devtools",
  "version": "0.0.5",
  "describe": {
    "tools": [
      {
        "name": "sh",
        "description": "在本机跑一条 PowerShell 命令（或 .ps1），返回输出。输出只留头 120 行 + 尾 40 行。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "description": "要执行的命令（和 scriptPath 二选一）"
            },
            "scriptPath": {
              "type": "string",
              "description": "可选，.ps1 的绝对路径；给了就忽略 command"
            },
            "cwd": {
              "type": "string",
              "description": "可选，工作目录"
            },
            "timeoutMs": {
              "type": "integer",
              "description": "可选，超时毫秒，默认 60000"
            }
          },
          "required": []
        },
        "tags": [
          "write"
        ]
      },
      {
        "name": "fs_read",
        "description": "读一个文本文件，按行返回；没变就不重发。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "description": "文件路径"
            },
            "offset": {
              "type": "integer",
              "description": "可选，从第几行开始（1 起）"
            },
            "limit": {
              "type": "integer",
              "description": "可选，读多少行，默认 200"
            },
            "maxBytes": {
              "type": "integer",
              "description": "可选，最多给多少字节，默认 16000"
            },
            "force": {
              "type": "boolean",
              "description": "可选，没变也重发全文"
            }
          },
          "required": [
            "path"
          ]
        },
        "tags": [
          "read"
        ]
      },
      {
        "name": "fs_write",
        "description": "写一个文本文件（会覆盖）。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "description": "文件路径"
            },
            "content": {
              "type": "string",
              "description": "内容"
            }
          },
          "required": [
            "path",
            "content"
          ]
        },
        "tags": [
          "write"
        ]
      },
      {
        "name": "web_fetch",
        "description": "抓一个网页/接口，返回正文文本。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "description": "网址"
            },
            "maxChars": {
              "type": "integer",
              "description": "可选，最多返回多少字，默认 8000"
            }
          },
          "required": [
            "url"
          ]
        },
        "tags": [
          "read"
        ]
      }
    ],
    "events": []
  }
}
