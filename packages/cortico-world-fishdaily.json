{
  "schema": 1,
  "name": "cortico-world-fishdaily",
  "version": "0.1.0-beta.4",
  "describe": {
    "tools": [
      {
        "name": "daily_today",
        "description": "查此刻(now)、看日程(view)、提交24h日程(plan)、改某段(adjust)、切清醒/晚安(wake_up)、取灵感(inspiration)或记事领币(log)。",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "view",
                "now",
                "plan",
                "adjust",
                "wake_up",
                "log",
                "inspiration"
              ],
              "description": "view=今日时间轴;now=此刻状态穿搭;plan=写全天日程;adjust=改/取消时段;wake_up=切回清醒(sleep=true互道晚安);inspiration=取防重灵感;log=记小事领币"
            },
            "sleep": {
              "type": "boolean",
              "description": "wake_up时true=同步晚安休息，默认false=保持清醒"
            },
            "date": {
              "type": "string",
              "description": "YYYY-MM-DD（plan默认明，adjust默认今）"
            },
            "dayType": {
              "type": "string",
              "description": "日型(workday/restday/outing/homebody/overtime/slacking)"
            },
            "title": {
              "type": "string",
              "description": "log标题或plan日主题"
            },
            "mood": {
              "type": "string",
              "description": "plan可选心情"
            },
            "diaryNotes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "plan口语打算(3~5条)"
            },
            "detail": {
              "type": "string",
              "description": "log/adjust补充细节"
            },
            "kind": {
              "type": "string",
              "enum": [
                "life",
                "chat_share"
              ],
              "description": "life=日常(+12币);chat_share=主动聊天(+10币)"
            },
            "scheduleItems": {
              "type": "array",
              "description": "plan连续00:00-24:00分段数组(>=2段)",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "description": "开始HH:MM"
                  },
                  "end": {
                    "type": "string",
                    "description": "结束HH:MM(末段可24:00)"
                  },
                  "activity": {
                    "type": "string",
                    "description": "做什么"
                  },
                  "location": {
                    "type": "string",
                    "description": "在哪"
                  },
                  "detail": {
                    "type": "string",
                    "description": "状态细节"
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "sleep",
                      "work",
                      "commute",
                      "meal",
                      "personal"
                    ]
                  },
                  "outfit": {
                    "type": "string",
                    "description": "穿着(对照衣柜)"
                  },
                  "scene": {
                    "type": "string",
                    "description": "场景名"
                  },
                  "props": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "道具"
                  }
                },
                "required": [
                  "start",
                  "end",
                  "activity"
                ]
              }
            },
            "start": {
              "type": "string",
              "description": "adjust开始HH:MM"
            },
            "end": {
              "type": "string",
              "description": "adjust结束HH:MM"
            },
            "activity": {
              "type": "string",
              "description": "adjust新活动名(空串=取消)"
            },
            "location": {
              "type": "string",
              "description": "adjust新地点"
            },
            "outfit": {
              "type": "string",
              "description": "adjust新穿搭"
            },
            "scene": {
              "type": "string",
              "description": "adjust新场景"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "adjust手边道具"
            },
            "planNote": {
