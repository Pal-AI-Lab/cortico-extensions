            "maleId": {
              "type": "string",
              "description": "公畜ID"
            },
            "batchId": {
              "type": "string",
              "description": "动物运输箱批次"
            },
            "quantity": {
              "type": "integer",
              "description": "饲料kg或动物数",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
