      {
        "name": "homestead_depart",
        "description": "营业时从家里带货和金币赶集；金币0.5g/枚。只携带指定库存批次，已有背包物件也计重；每批可指定carrierId，将该批交给已选择的随行牲畜。年龄、健康、饱腹及物种影响负重和路速。",
        "parameters": {
          "type": "object",
          "properties": {
            "coins": {
              "type": "number",
              "description": "从钱箱带的金币",
              "minimum": 0,
              "maximum": 1000000
            },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "properties": {
                  "batchId": {
                    "type": "string",
                    "description": "库存批次ID"
                  },
                  "quantity": {
                    "type": "integer",
                    "description": "件数",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "carrierId": {
                    "type": "string",
                    "description": "随行家畜ID，不用牲畜驮运时省略"
                  }
                },
                "required": [
                  "batchId",
                  "quantity"
                ],
                "additionalProperties": false
              }
            },
            "followers": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "description": "随行家畜ID"
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "tags": [
          "write"
        ],
        "summary": {
          "zh": "营业时从家里带货和金币赶集；金币0.5g/枚。只携带指定库存批次，已有背包物件也计重；每批可指定carrierId，将该批交给已选择的随行牲畜。年龄、健康、饱腹及物种影响负重和路速。",
          "en": "homestead_depart"
        }
      },
      {
        "name": "homestead_trade",
        "description": "到达开放的集市后买卖或以物易物。购买用stockId；出售或交换用offer列出背包批次与数量。mode=butcher使用本次随行健康动物委托代宰；mode=porter选择食材坊待托运屠宰品，次日08:00送到家。费用可用物品抵偿，多余不找零。",
        "parameters": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "buy",
                "sell",
                "barter",
                "butcher",
                "porter"
              ]
            },
            "stockId": {
              "type": "string",
              "description": "货架ID"
            },
            "quantity": {
              "type": "integer",
              "description": "购买数量",
              "minimum": 1,
              "maximum": 1000
            },
            "offer": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "properties": {
                  "batchId": {
                    "type": "string",
                    "description": "库存批次ID"
                  },
                  "quantity": {
                    "type": "integer",
                    "description": "件数",
                    "minimum": 1,
                    "maximum": 1000
                  }
                },
                "required": [
                  "batchId",
                  "quantity"
                ],
                "additionalProperties": false
              }
            },
            "animalIds": {
              "type": "array",
              "maxItems": 8,
