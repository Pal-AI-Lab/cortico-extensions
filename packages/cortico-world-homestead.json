                "rest",
                "cancel_rest",
                "play",
                "medicine"
              ]
            },
            "liters": {
              "type": "number",
              "description": "打水升数",
              "minimum": 1,
              "maximum": 50
            },
            "hours": {
              "type": "number",
              "description": "休息小时",
              "minimum": 0.25,
              "maximum": 12
            },
            "outdoors": {
              "type": "boolean"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "tags": [
          "write"
        ],
        "summary": {
