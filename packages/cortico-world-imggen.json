{
  "schema": 1,
  "name": "cortico-world-imggen",
  "version": "0.4.3",
  "describe": {
    "tools": [
      {
        "name": "imggen_draw",
        "description": "画一张图，存本地并发 QQ。prompt 只写画面；神态/动作/镜头/光线用关键词；人物/服饰/场景/道具填库里的名字。to 抄消息 meta 里的 conv。回执含路径、尺寸和发送结果；「生成失败」不算成功。本地约 30 秒~2 分钟。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "description": "画面本身：谁在做啥、在哪、什么风格。一到两句；本地写英文 tag"
            },
            "characters": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "人物名（库里的）"
            },
            "outfits": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "服饰名，不填自动配"
            },
            "scene": {
              "type": "string",
              "description": "场景名"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "道具名"
            },
            "situation": {
              "type": "string",
              "description": "情境关键词（定整体场合）"
            },
            "expression": {
              "type": "string",
              "description": "神态关键词"
            },
            "pose": {
              "type": "string",
              "description": "动作关键词"
            },
            "shot": {
              "type": "string",
              "description": "镜头关键词"
            },
            "light": {
              "type": "string",
              "description": "光线，不填用情境默认"
            },
            "size": {
              "type": "string",
              "description": "尺寸，如 1024x1024"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "张数，默认 1"
            },
            "to": {
              "type": "string",
              "description": "group:<群号> / private:<QQ号>"
            },
            "caption": {
              "type": "string",
              "description": "跟图一起说的话"
            },
            "send": {
              "type": "boolean",
              "description": "false = 只存不发"
            }
          },
          "required": [
            "prompt"
          ]
        },
        "tags": [
          "act"
        ],
        "summary": {
          "zh": "按描述和参考库画一张图，存本地并发到 QQ。",
          "en": "Draws an image using the reference library, saves it and sends it to QQ."
        }
      },
      {
        "name": "imggen_redraw",
        "description": "以图改图：拿一张已有的图当底图，按 prompt 重绘。file 填 imggen_list 的文件名或绝对路径，不填用最新一张。denoise 越小越贴近原图（0.3 只是微调细节，0.7 改动很大），默认 0.55。底图的构图和人物位置会保留，只有画面内容按 prompt 变。只有本地 ComfyUI 支持，云端会拒绝。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "description": "底图文件名或绝对路径；不填=最新一张"
            },
            "prompt": {
              "type": "string",
              "description": "改完要变成什么样，写英文 tag 更稳"
            },
            "denoise": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 0.95,
              "description": "重绘幅度，默认 0.55"
            },
            "to": {
              "type": "string",
              "description": "group:<群号> / private:<QQ号>"
            },
            "caption": {
              "type": "string",
              "description": "跟图一起说的话"
            },
            "send": {
              "type": "boolean",
              "description": "false = 只存不发"
            }
          },
          "required": [
            "prompt"
          ]
        },
        "tags": [
          "act"
        ],
        "summary": {
          "zh": "拿一张已有的图当底图改图（图生图）。",
          "en": "Redraws an existing image with a prompt (img2img)."
        }
      },
      {
        "name": "imggen_send",
        "description": "把生成过的图再发一次（不重新生成、不花钱）。file 填 imggen_list 给的文件名，不填发最新一张。对方说「再发一次」时用它，别重新画。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "description": "文件名；不填=最新一张"
            },
            "to": {
              "type": "string",
              "description": "group:<群号> / private:<QQ号>"
            },
            "caption": {
              "type": "string",
              "description": "跟图一起说的话"
            }
          },
          "required": []
        },
        "tags": [
          "act"
        ],
        "summary": {
          "zh": "把之前画好的图再发一次，不重新生成。",
          "en": "Resends an image that was already generated."
        }
      },
      {
        "name": "imggen_list",
        "description": "列出已生成的图（文件名/大小/时间）和保存目录。给 imggen_send 挑文件名时用。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "最多几张，默认 10"
            }
          },
          "required": []
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "列出本地已生成的图。",
          "en": "Lists generated images on disk."
        }
      },
      {
        "name": "imggen_library",
        "description": "本地参考库（人物/服饰/场景/道具）：list 看清单，get 看某条设定与参考图，add 存新条目（file 填路径或 http 地址），update 改字段，remove 挪回收站。出图前不确定名字就 list，别猜。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "get",
                "add",
                "update",
                "remove"
              ],
              "description": "要做的事。"
            },
            "category": {
              "type": "string",
              "enum": [
                "characters",
                "outfits",
                "scenes",
                "props"
              ],
              "description": "库分类：characters 人物 / outfits 服饰 / scenes 场景 / props 道具。"
            },
            "name": {
              "type": "string",
              "description": "条目名"
            },
            "description": {
              "type": "string",
              "description": "外观，只写长相/设计"
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "别名"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "标签"
            },
            "persona": {
              "type": "string",
              "description": "人设，不外发"
            },
            "expressions": {
              "type": "string",
              "description": "神态特点"
            },
            "defaultOutfit": {
              "type": "string",
              "description": "默认服饰名"
            },
            "outfitByContext": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "情境→服饰，如 {\"睡前\":\"睡衣\"}"
            },
            "file": {
              "type": "string",
              "description": "参考图路径或 URL"
            }
          },
          "required": [
            "action"
          ]
        },
        "tags": [
          "read",
          "act"
        ],
        "summary": {
          "zh": "查本地参考库（人物/服饰/场景/道具），也能把图存成新条目。",
          "en": "Queries or edits the local reference library."
        }
      },
      {
        "name": "imggen_jobs",
        "description": "查后台出图任务（本地出图很慢时 imggen_draw 会先回任务号，画好自动发）。想知道「画好了没」才查，正常闲聊不用。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "最多几条，默认 5"
            }
          },
          "required": []
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "查后台出图任务的进度（本地出图时用）。",
          "en": "Checks background drawing jobs."
        }
      },
      {
        "name": "imggen_comfy",
        "description": "本地设置：status 看状态，list 列可用 LoRA / 工作流（按架构分组），set 改（backend=local|cloud；model=本地模型架构名；lora=文件名，空串不挂；workflow=路径或文件名，空串用内置）。profiles / useProfile / saveProfile 管后端档案。换画风、换 LoRA、快速试几张用它。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "q": {
              "type": "string",
              "description": "list 时按关键词过滤 LoRA / 工作流名"
            },
            "action": {
              "type": "string",
              "enum": [
                "status",
                "list",
                "set",
                "profiles",
                "useProfile",
                "saveProfile",
                "restart"
              ],
              "description": "status 看状态；list 列 LoRA/工作流；set 改后端/模型/LoRA/工作流；profiles 列档案；useProfile 切档案；saveProfile 存档案"
            },
            "backend": {
              "type": "string",
              "enum": [
                "local",
                "cloud"
              ],
              "description": "set：local/cloud"
            },
            "model": {
              "type": "string",
              "enum": [
                "krea2",
                "anima"
              ],
              "description": "set：本地模型架构（本机装的那几个；不确定先 status）"
            },
            "lora": {
              "type": "string",
              "description": "set：角色 LoRA 文件名，空=不挂"
            },
            "workflow": {
              "type": "string",
              "description": "set：工作流文件名，空=内置"
            },
            "profile": {
              "type": "string",
              "description": "useProfile/saveProfile：档案名"
            },
            "apiKey": {
              "type": "string",
              "description": "saveProfile：顺手把这个档案的 key 存下来（可选）"
            }
          },
          "required": [
            "action"
          ]
        },
        "tags": [
          "read",
          "act"
        ],
        "summary": {
          "zh": "看/改本地 ComfyUI 的设置（用哪个 LoRA、哪个工作流）。",
          "en": "Views or changes local ComfyUI options (LoRA, workflow)."
        }
      }
    ],
    "events": []
  }
}
