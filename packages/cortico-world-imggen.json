{
  "schema": 1,
  "name": "cortico-world-imggen",
  "version": "0.4.0",
  "describe": {
    "tools": [
      {
        "name": "imggen_draw",
        "description": "画一张图存本地并发 QQ。prompt 只写画面；神态/动作/镜头/光线用关键词。人物/服饰/场景/道具填库里的名字；to 抄消息 meta 里的 conv。回执有路径、尺寸、参考图和发送结果；「生成失败」开头不算成功。本地出图需等几十秒到两分钟。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "description": "画面：谁在做什么、在哪、什么风格。一到两句；本地模式写英文 tag。"
            },
            "characters": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "人物名（库里的，可多个）"
            },
            "outfits": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "服饰名，不填自动搭配"
            },
            "scene": {
              "type": "string",
              "description": "场景名"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "道具名"
            },
            "situation": {
              "type": "string",
              "description": "情境关键词"
            },
            "expression": {
              "type": "string",
              "description": "神态关键词"
            },
            "pose": {
              "type": "string",
              "description": "动作关键词"
            },
            "shot": {
              "type": "string",
              "description": "镜头关键词"
            },
            "light": {
              "type": "string",
              "description": "光线，不填用情境默认"
            },
            "size": {
              "type": "string",
              "description": "尺寸，如 1024x1024"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "张数，默认 1"
            },
            "to": {
              "type": "string",
              "description": "group:<群号> / private:<QQ号>"
            },
            "caption": {
              "type": "string",
              "description": "跟图一起说的话"
            },
            "send": {
              "type": "boolean",
              "description": "false = 只存不发"
            }
          },
          "required": [
            "prompt"
          ]
        },
        "tags": [
          "act"
        ],
        "summary": {
          "zh": "按描述和参考库画一张图，存本地并发到 QQ。",
          "en": "Draws an image using the reference library, saves it and sends it to QQ."
        }
      },
      {
        "name": "imggen_send",
        "description": "把生成过的图再发一次（不重新生成、不花钱）。file 填 imggen_list 给的文件名，不填发最新一张。对方说「再发一次」时用它，别重新画。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "description": "文件名；不填=最新一张"
            },
            "to": {
              "type": "string",
              "description": "group:<群号> / private:<QQ号>"
            },
            "caption": {
              "type": "string",
              "description": "跟图一起说的话"
            }
          },
          "required": []
        },
        "tags": [
          "act"
        ],
        "summary": {
          "zh": "把之前画好的图再发一次，不重新生成。",
          "en": "Resends an image that was already generated."
        }
      },
      {
        "name": "imggen_list",
        "description": "列出已生成的图（文件名/大小/时间）和保存目录。给 imggen_send 挑文件名时用。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "最多几张，默认 10"
            }
          },
          "required": []
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "列出本地已生成的图。",
          "en": "Lists generated images on disk."
        }
      },
      {
        "name": "imggen_library",
        "description": "本地参考库（人物/服饰/场景/道具）：list 看清单，get 看某条设定与参考图，add 存新条目（file 填路径或 http 地址），update 改字段，remove 挪回收站。出图前不确定名字就 list，别猜。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "get",
                "add",
                "update",
                "remove"
              ],
              "description": "要做的事。"
            },
            "category": {
              "type": "string",
              "enum": [
                "characters",
                "outfits",
                "scenes",
                "props"
              ],
              "description": "库分类：characters 人物 / outfits 服饰 / scenes 场景 / props 道具。"
            },
            "name": {
              "type": "string",
              "description": "条目名"
            },
            "description": {
              "type": "string",
              "description": "外观，只写长相/设计"
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "别名"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "标签"
            },
            "persona": {
              "type": "string",
              "description": "人设，不外发"
            },
            "expressions": {
              "type": "string",
              "description": "神态特点"
            },
            "defaultOutfit": {
              "type": "string",
              "description": "默认服饰名"
            },
            "outfitByContext": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "情境→服饰，如 {\"睡前\":\"睡衣\"}"
            },
            "file": {
              "type": "string",
              "description": "参考图路径或 URL"
            }
          },
          "required": [
            "action"
          ]
        },
        "tags": [
          "read",
          "act"
        ],
        "summary": {
          "zh": "查本地参考库（人物/服饰/场景/道具），也能把图存成新条目。",
          "en": "Queries or edits the local reference library."
        }
      },
      {
        "name": "imggen_jobs",
        "description": "查后台出图任务（本地出图很慢时 imggen_draw 会先回任务号，画好自动发）。想知道「画好了没」才查，正常闲聊不用。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "最多几条，默认 5"
            }
          },
          "required": []
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "查后台出图任务的进度（本地出图时用）。",
          "en": "Checks background drawing jobs."
        }
      },
      {
        "name": "imggen_comfy",
        "description": "本地 ComfyUI 的设置：status 看当前用哪个 LoRA / 工作流，list 列出可选的 LoRA 文件，set 改成别的（backend 选 local/cloud；lora 传文件名、空串表示不挂；workflow 传 API 格式 JSON 的路径或文件名、空串表示内置）。切到 local 后是纯提示词模式：要自己写完整英文提示词，别用参考库。对方说「换个画风」「用 XX LoRA」「换成我的工作流」时用它。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "status",
                "list",
                "set"
              ],
              "description": "要做的事"
            },
            "backend": {
              "type": "string",
              "enum": [
                "local",
                "cloud"
              ],
              "description": "set：local/cloud"
            },
            "lora": {
              "type": "string",
              "description": "set：角色 LoRA 文件名，空=不挂"
            },
            "workflow": {
              "type": "string",
              "description": "set：工作流文件名，空=内置"
            }
          },
          "required": [
            "action"
          ]
        },
        "tags": [
          "read",
          "act"
        ],
        "summary": {
          "zh": "看/改本地 ComfyUI 的设置（用哪个 LoRA、哪个工作流）。",
          "en": "Views or changes local ComfyUI options (LoRA, workflow)."
        }
      }
    ],
    "events": []
  }
}
