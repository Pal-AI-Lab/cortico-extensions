{
  "schema": 1,
  "name": "cortico-world-imggen",
  "version": "0.3.4",
  "describe": {
    "tools": [
      {
        "name": "imggen_draw",
        "description": "画一张图存到本地并直接发到 QQ。prompt 只写画面本身，神态/动作/镜头/光线用下面的关键词，别在 prompt 里重复。人物/服饰/场景/道具都填参考库里的名字；to 抄 QQ 消息 meta 里的 conv。回执有路径、尺寸、关键词、参考图和发送结果，「生成失败」开头不算成功；一张几十秒，等回执。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "description": "画面：谁在做什么、在哪、什么风格。一到三句。"
            },
            "characters": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "出镜人物（库里的名字，可多个），保证长相一致。"
            },
            "outfits": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "服饰（库里的名字），不填自动搭配。"
            },
            "scene": {
              "type": "string",
              "description": "场景（库里的名字）。"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "道具（库里的名字）。"
            },
            "situation": {
              "type": "string",
              "description": "情境（词表里的名字）。"
            },
            "expression": {
              "type": "string",
              "description": "神态（词表里的名字）。"
            },
            "pose": {
              "type": "string",
              "description": "动作（词表里的名字）。"
            },
            "shot": {
              "type": "string",
              "description": "镜头（词表里的名字）。"
            },
            "light": {
              "type": "string",
              "description": "光线（词表里的名字），不填用情境默认。"
            },
            "size": {
              "type": "string",
              "description": "覆盖默认尺寸，如 1024x1024。"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "张数，默认 1；多张更慢更贵。"
            },
            "to": {
              "type": "string",
              "description": "group:<群号> 或 private:<QQ号>；不填用默认目标。"
            },
            "caption": {
              "type": "string",
              "description": "跟图一起发的一句话。"
            },
            "send": {
              "type": "boolean",
              "description": "false = 只生成不发。"
            }
          },
          "required": [
            "prompt"
          ]
        },
        "tags": [
          "act"
        ],
        "summary": {
          "zh": "按描述和参考库画一张图，存本地并发到 QQ。",
          "en": "Draws an image using the reference library, saves it and sends it to QQ."
        }
      },
      {
        "name": "imggen_send",
        "description": "把之前生成过的一张图再发一次（不重新生成，不花钱）。file 填 imggen_list 给出的文件名，不填就发最新的一张。对方说「再发一次」「发刚才那张」时用它，不要重新 imggen_draw。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "description": "文件名或完整路径（必须在本扩展的图片目录内）。不填 = 最新一张。"
            },
            "to": {
              "type": "string",
              "description": "发送目标：group:<群号> 或 private:<QQ号>。不填用默认目标。"
            },
            "caption": {
              "type": "string",
              "description": "可选，跟图一起发出的一句话。"
            }
          },
          "required": []
        },
        "tags": [
          "act"
        ],
        "summary": {
          "zh": "把之前画好的图再发一次，不重新生成。",
          "en": "Resends an image that was already generated."
        }
      },
      {
        "name": "imggen_list",
        "description": "列出本地已生成的图片（文件名、大小、时间）和保存目录。想知道有哪些图、或要给 imggen_send 挑文件名时用。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "最多列几张，默认 10。"
            }
          },
          "required": []
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "列出本地已生成的图。",
          "en": "Lists generated images on disk."
        }
      },
      {
        "name": "imggen_library",
        "description": "本地参考库（人物/服饰/场景/道具）。list 看清单，get 看某条设定与参考图，add 存新条目（file 填图片路径或 http 地址），update 改字段，remove 挪进回收站。出图前不确定名字就 list，别猜；对方说「记住这个角色」先拿图片路径再 add。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "get",
                "add",
                "update",
                "remove"
              ],
              "description": "要做的事。"
            },
            "category": {
              "type": "string",
              "enum": [
                "characters",
                "outfits",
                "scenes",
                "props"
              ],
              "description": "库分类：characters 人物 / outfits 服饰 / scenes 场景 / props 道具。"
            },
            "name": {
              "type": "string",
              "description": "条目名（get/update/remove 用；add 时是新条目名）。"
            },
            "description": {
              "type": "string",
              "description": "add/update：外观描述，只写长相或设计，会进提示词。"
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "add/update：别名。"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "add/update：标签。"
            },
            "persona": {
              "type": "string",
              "description": "add/update：人设，只给自己看，不外发。"
            },
            "expressions": {
              "type": "string",
              "description": "add/update：神态特点，会进提示词。"
            },
            "defaultOutfit": {
              "type": "string",
              "description": "add/update：默认服饰（服饰条目名）。"
            },
            "outfitByContext": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "add/update：情境→服饰名，如 {\"睡前\":\"睡衣\"}；也收 \"睡前=睡衣, 刚睡醒=睡衣\"。只对人物有用。"
            },
            "file": {
              "type": "string",
              "description": "add：参考图，本地路径或 http(s) 地址。"
            }
          },
          "required": [
            "action"
          ]
        },
        "tags": [
          "read",
          "act"
        ],
        "summary": {
          "zh": "查本地参考库（人物/服饰/场景/道具），也能把图存成新条目。",
          "en": "Queries or edits the local reference library."
        }
      }
    ],
    "events": []
  }
}
