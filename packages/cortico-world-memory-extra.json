              "title": "要清理的记忆域(逗号分隔)"
            },
            "confirm": {
              "type": "number",
              "title": "确认删除:填1"
            }
          },
          "required": [
            "action"
          ]
        },
        "tags": [
          "read",
          "write",
          "act",
          "snapshot"
        ],
        "summary": {
          "zh": "查看统计、捕获消息、补建索引、清理污染或立即落盘。",
          "en": "Inspect, capture, backfill, purge capture pollution or flush the stores."
        }
      },
