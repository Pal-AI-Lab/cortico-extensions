{
  "schema": 1,
  "name": "cortico-world-memory-extra",
  "version": "0.4.0",
  "describe": {
    "tools": [
      {
        "name": "mem_memory",
        "description": "记忆、检索、短期窗口、摘要、来源查看、纠错、遗忘与去重整理。检索默认当前 user_id/提示词记忆域，未命中才查 shared；scope=ALL 显式跨域。correct 需要 id/text；forget/consolidate 先预览，confirm=1 执行。衍生摘要用 source_ids 关联原记忆。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_ids": {
              "type": "string",
              "title": "来源记忆ID，逗号分隔"
            },
            "action": {
              "type": "string",
              "enum": [
                "remember",
                "recall",
                "recent",
                "overflow",
                "summary",
                "topic",
                "inspect",
                "correct",
                "forget",
                "consolidate"
              ],
              "description": "remember=写入长期事实；recall=混合检索长期记忆；recent=查看最近短期对话；overflow=取出溢出短期条目；summary=读取或写入对话摘要；topic=读取或写入当前话题；inspect=查看记录来源和历史状态；correct=按ID纠正并停用旧记录；forget=预览或确认完整遗忘；consolidate=预览或合并重复记忆"
            },
            "text": {
              "type": "string",
              "title": "内容/摘要/话题"
            },
            "query": {
              "type": "string",
              "title": "查询"
            },
            "top_k": {
              "type": "number",
              "title": "条数"
            },
            "n": {
              "type": "number",
              "title": "最近条数"
            },
            "scope": {
              "type": "string",
              "title": "记忆域，ALL显式跨域"
            },
            "id": {
              "type": "string",
              "title": "记忆ID"
            },
            "kind": {
              "type": "string",
              "enum": [
                "raw",
                "confirmed",
                "inference"
              ]
            },
            "user_id": {
              "type": "string",
              "title": "用户记忆域"
            },
            "session_id": {
              "type": "string",
              "title": "会话ID"
            },
            "importance": {
              "type": "number",
              "title": "重要度0-1"
            },
            "confirm": {
              "type": "number",
              "title": "确认执行填1"
            }
          },
          "required": [
            "action"
          ]
        },
        "tags": [
          "read",
          "write",
          "act",
          "snapshot"
        ],
        "summary": {
          "zh": "短期与长期记忆操作:记忆、检索、最近对话、溢出条目、摘要和当前话题。",
          "en": "Short- and long-term memory: remember, recall, recent turns, overflow, summary and topic."
        }
      },
