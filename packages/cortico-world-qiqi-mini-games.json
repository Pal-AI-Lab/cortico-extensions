{
  "schema": 1,
  "name": "cortico-world-qiqi-mini-games",
  "version": "0.11.0",
  "describe": {
    "tools": [
      {
        "name": "mini_game_flip_coin",
        "description": "用户明确请你抛硬币时调用。随机返回正面或反面，按照工具结果回复。",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "tags": [
          "read",
          "write"
        ],
        "summary": {
          "zh": "抛一枚硬币",
          "en": "Flip a coin"
        }
      },
      {
        "name": "mini_game_roll_die",
        "description": "用户明确请你掷骰子时调用。按指定类型掷一次，按照工具结果回复。用户未指明类型时先询问。",
        "parameters": {
          "type": "object",
          "properties": {
            "die": {
              "type": "string",
              "enum": [
                "d4",
                "d6",
                "d8",
                "d10",
                "d20",
                "d100"
              ]
            }
          },
          "required": [
            "die"
          ],
          "additionalProperties": false
        },
        "tags": [
          "read",
          "write"
        ],
        "summary": {
          "zh": "掷一次 d4、d6、d8、d10、d20 或 d100",
          "en": "Roll a d4, d6, d8, d10, d20, or d100"
        }
      },
      {
        "name": "mini_game_flight_board",
        "description": "查看当前飞行棋棋盘、每架飞机的位置、当前回合和合法走法。",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "读取飞行棋棋盘",
          "en": "Read the flight board"
        }
      },
      {
        "name": "mini_game_flight_play",
        "description": "只在本地 Bot 自己的飞行棋回合掷骰或走棋。使用最新棋盘的 id 和 rev；move 时填 choices 中的飞机编号。返回新棋盘。",
        "parameters": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "rev": {
              "type": "integer",
              "minimum": 0
            },
            "action": {
              "type": "string",
              "enum": [
                "roll",
                "move"
              ]
            },
            "plane": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": [
            "id",
            "rev",
            "action"
          ],
          "additionalProperties": false
        },
        "tags": [
          "act"
        ],
        "summary": {
          "zh": "掷骰或走棋",
          "en": "Roll or move in flight"
        }
      },
      {
        "name": "mini_game_tabletop_state",
        "description": "查看跑团身份、地图、棋子和版本号。overview 默认概览；board 查地形；actor 用 actorId 查数值；gm 读取当前地图的私有城主帷幕。坐标从 0 起。",
        "parameters": {
          "type": "object",
          "properties": {
            "view": {
              "type": "string",
              "enum": [
                "overview",
                "board",
                "actor",
                "gm"
              ]
            },
            "actorId": {
              "type": "string"
            },
            "region": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer"
                },
                "y": {
                  "type": "integer"
                },
                "width": {
                  "type": "integer"
                },
                "height": {
                  "type": "integer"
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "tags": [
          "read",
          "snapshot"
        ],
        "summary": {
          "zh": "读跑团棋盘和角色",
          "en": "Read tabletop maps and characters"
        }
      },
      {
        "name": "mini_game_tabletop_rules",
        "description": "读跑团资料。bot 是行动参数（默认），skill 是布团步骤，setup 是导入格式，starter 是第四版入门速查。",
