{
  "schema": 1,
  "name": "cortico-world-todo-alont1",
  "version": "0.1.5",
  "describe": {
    "tools": [
      {
        "name": "todo_add",
        "description": "往任务板记一条要做的事（答应谁的、哪天要做的）。due 可以不填。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "description": "要做的事，一句话。"
            },
            "due": {
              "type": "string",
              "description": "什么时候要（如 明早5点 / 10-20 晚上），可不填。"
            }
          },
          "required": [
            "text"
          ]
        },
        "tags": [
          "write"
        ],
        "summary": {
          "zh": "记一条要做的事",
          "en": "Add a todo"
        }
      },
      {
        "name": "todo_list",
        "description": "看任务板：还没做的都在，按记下的顺序。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "boolean",
              "description": "true 连做完的一起看。"
            }
          }
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "看任务板",
          "en": "List todos"
        }
      },
      {
        "name": "todo_done",
        "description": "把某条标记成做完了（要 id，来自 todo_list）。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "description": "条目 id。"
            }
          },
          "required": [
            "id"
          ]
        },
        "tags": [
          "write"
        ],
        "summary": {
          "zh": "标记完成",
          "en": "Mark done"
        }
      },
      {
        "name": "todo_remove",
        "description": "删掉某条（不想做了/记错了）。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "description": "条目 id。"
            }
          },
          "required": [
            "id"
          ]
        },
        "tags": [
          "write"
        ],
        "summary": {
          "zh": "删一条",
          "en": "Remove a todo"
        }
      }
    ],
    "events": []
  },
  "changelog": {
    "0.1.5": "- 详情配置不再包含宿主启用总开关，避免过期表单保存其他设置时意外关闭扩展。\n- 启用/停用统一使用宿主卡片；真实业务子开关仍可配置，中文教程明确保存与重新挂载的区别。\n\n迁移：升级后重载宿主并刷新控制台页面；如果旧版已把总开关保存为 false，请在宿主卡片重新激活一次。若旧实例仍显示在线，可先停用再激活。修复不会猜测或覆盖用户已有停用选择。\n\n<!-- Owner: package.json and packaged source -->",
    "0.1.4": "- 保留原子持久化和坏状态文件保护，核对独立事项管理。\n- 面板保留快速交替启停的最终停止，显示执行中调用与耗时，按 failed:true 统计失败；面板代码随包内置。\n- 按 Cortico 0.2.7 的 World API 6 / Bot API 7 检查适用契约；单包产物不引入其他扩展。"
  }
}
