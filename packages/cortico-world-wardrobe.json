{
  "schema": 1,
  "name": "cortico-world-wardrobe",
  "version": "0.3.0",
  "describe": {
    "tools": [
      {
        "name": "wardrobe_status",
        "description": "看换装形象包是否已装到 companion/figures，以及管理页地址。不改官方鲸鱼任何文件。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "tags": [
          "read"
        ],
        "summary": "查看换装形象包状态"
      },
      {
        "name": "wardrobe_install",
        "description": "把换装形象包装进 companion/figures/wardrobe-whale。不覆盖官方鲸鱼宿主文件。装完请在换装页选「换装鲸鱼」。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "tags": [
          "write"
        ],
        "summary": "安装换装形象包"
      },
      {
        "name": "wardrobe_manage",
        "description": "返回衣橱管理页 URL：可导入 zip、从官方鲸鱼只读抄衣服、导出衣服。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "tags": [
          "read"
        ],
        "summary": "打开管理页地址"
      },
      {
        "name": "wardrobe_clothes",
        "description": "列出换装形象包能选的配色、衣服和头发，以及当前穿着。须已选中该形象。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "tags": [
          "read"
        ],
        "summary": "查看能选的衣服和头发"
      },
      {
        "name": "wardrobe_wear",
        "description": "给换装形象包换衣服或头发。只填要改的项。须先在换装页选中 wardrobe-whale。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scheme": {
              "type": "string",
              "description": "配色 id"
            },
            "set": {
              "type": "string",
              "description": "套装 id，混搭用 none"
            },
            "headwear": {
              "type": "string",
              "description": "头饰 id"
            },
            "top": {
              "type": "string",
              "description": "上身 id"
            },
            "bottom": {
              "type": "string",
              "description": "下身 id"
            },
            "shoe": {
              "type": "string",
              "description": "鞋子 id"
            },
            "bangs": {
              "type": "string",
              "description": "刘海 id"
            },
            "back": {
              "type": "string",
              "description": "发尾 id"
            },
            "style": {
              "type": "string",
              "description": "发型 id"
            },
            "ahoge": {
              "type": "string",
              "description": "呆毛 id"
            }
          }
        },
        "tags": [
          "write"
        ],
        "summary": "给形象包换衣服或头发"
      }
    ],
    "events": [],
    "prompts": [
      {
        "key": "worlds.wardrobe.envPrompt",
        "title": "换装 · 环境提示词",
        "role": "envPrompt",
        "content": "这台电脑有独立的换装形象包（id：{{wardrobe.figureId}}），不改官方鲸鱼。管理页：{{wardrobe.manageUrl}}（可导入 zip，或从官方鲸鱼只读抄衣服）。\n\n主人要穿这套形象时，须在换装页选「换装鲸鱼」。你可以调用 wardrobe_clothes / wardrobe_wear 给她换衣服。\n\n当前状态：{{wardrobe.status}}\n"
      }
    ]
  }
}
