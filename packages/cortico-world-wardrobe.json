{
  "schema": 1,
  "name": "cortico-world-wardrobe",
  "version": "0.2.2",
  "describe": {
    "tools": [
      {
        "name": "wardrobe_status",
        "description": "看这台电脑上的 Coopanion 鲸鱼衣橱有没有装上「新增衣服 / 新增头发」。不改任何文件。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "tags": [
          "read"
        ],
        "summary": "查看换装补丁是否已装上"
      },
      {
        "name": "wardrobe_install",
        "description": "把非官方的新增衣服、新增头发写进本机 Coopanion 的鲸鱼衣橱。已有的衣服、头发和身体尺寸不会被换掉。装完要完全退出桌宠再打开。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "tags": [
          "write"
        ],
        "summary": "把换装补丁装进本机鲸鱼"
      },
      {
        "name": "wardrobe_clothes",
        "description": "列出鲸鱼现在能选的配色、衣服和头发，以及她现在穿着什么。不改打扮。选之前先看这一份。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "tags": [
          "read"
        ],
        "summary": "查看能选的衣服和头发"
      },
      {
        "name": "wardrobe_wear",
        "description": "给鲸鱼换衣服或头发。只填要改的项，其余保持原样。衣服和头发分开。set 用 none 表示混搭。穿着套装时如果换了另一件上身或下身，会变成混搭。id 必须来自 wardrobe_clothes。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scheme": {
              "type": "string",
              "description": "配色 id"
            },
            "set": {
              "type": "string",
              "description": "套装 id，混搭用 none"
            },
            "headwear": {
              "type": "string",
              "description": "头饰 id"
            },
            "top": {
              "type": "string",
              "description": "上身 id"
            },
            "bottom": {
              "type": "string",
              "description": "下身 id"
            },
            "bangs": {
              "type": "string",
              "description": "刘海 id"
            },
            "back": {
              "type": "string",
              "description": "发尾 id"
            },
            "style": {
              "type": "string",
              "description": "发型 id"
            },
            "ahoge": {
              "type": "string",
              "description": "呆毛 id"
            }
          }
        },
        "tags": [
          "write"
        ],
        "summary": "给鲸鱼换衣服或头发"
      }
    ],
    "events": [],
    "prompts": [
      {
        "key": "worlds.wardrobe.envPrompt",
        "title": "换装 · 环境提示词",
        "role": "envPrompt",
        "content": "这台电脑的鲸鱼衣橱可以新增衣服和头发。主人要加衣服时，去换装页按「新增衣服」或「新增头发」，可以一次选多个 zip。\n\n你可以自己给鲸鱼换衣服和头发。先调用 wardrobe_clothes 看有哪些。再调用 wardrobe_wear，只填要换的项：scheme 配色，set 套装（混搭是 none），headwear 头饰，top 上身，bottom 下身，bangs 刘海，back 发尾，style 发型，ahoge 呆毛。衣服和头发分开选。穿着套装时换了另一件上身或下身，会变成混搭。\n\n当前状态：{{wardrobe.status}}\n"
      }
    ]
  }
}
