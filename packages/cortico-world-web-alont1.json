{
  "schema": 1,
  "name": "cortico-world-web-alont1",
  "version": "0.1.4",
  "describe": {
    "tools": [
      {
        "name": "web_find",
        "description": "联网搜索（Bing），返回标题、链接和摘要。查资料、看新闻、了解一件事的现状用这个。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query": {
              "type": "string",
              "description": "搜什么，中英文都行。"
            },
            "count": {
              "type": "integer",
              "description": "要几条，默认用配置值。"
            }
          },
          "required": [
            "query"
          ]
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "联网搜索",
          "en": "Web search"
        }
      },
      {
        "name": "web_read",
        "description": "打开一个网页，返回去掉标签后的正文（截断）。搜索结果里挑一条读全文用这个。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "description": "http(s) 链接。"
            },
            "max_chars": {
              "type": "integer",
              "description": "最多返回多少字符，默认用配置值。"
            }
          },
          "required": [
            "url"
          ]
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "读网页正文",
          "en": "Fetch a page as text"
        }
      }
    ],
    "events": []
  },
  "changelog": {
    "0.1.4": "- 网页响应采用流式 4 MiB 上限并拒绝二进制；非法数值 HTML 实体保留原文，不再崩溃。\n- 面板保留快速交替启停的最终停止，显示执行中调用与耗时，按 failed:true 统计失败；面板代码随包内置。\n- 按 Cortico 0.2.7 的 World API 6 / Bot API 7 检查适用契约；单包产物不引入其他扩展。"
  }
}
