{
  "schema": 1,
  "name": "cortico-world-websearch",
  "version": "0.2.1",
  "describe": {
    "tools": [
      {
        "name": "web_search",
        "description": "Search the public internet for recent or uncertain information. Returns concise, numbered evidence with sources. Default to calling it once.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "q": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "description": "Focused search query. Keep key names, dates and platforms; do not paste whole chat logs or private info."
            },
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "answer",
                "links",
                "news",
                "images",
                "videos"
              ],
              "default": "auto",
              "description": "\"answer\" for evidence to answer a question; \"links\" for web pages; others search that content type."
            },
            "fresh": {
              "type": "string",
              "enum": [
                "any",
                "day",
                "week",
                "month",
                "year"
              ],
              "default": "any"
            },
            "n": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "default": 4
            }
          },
          "required": [
            "q"
          ]
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "用 Brave Search 搜网页、新闻、图片或视频,拿回带来源的几条结果。",
          "en": "Searches the web, news, images or videos through Brave Search and returns a few results with sources."
        }
      }
    ],
    "events": [],
    "prompts": [
      {
        "key": "worlds.websearch.envPrompt",
        "title": "WebSearch · 环境提示词",
        "role": "envPrompt",
        "content": "\n"
      }
    ]
  }
}
