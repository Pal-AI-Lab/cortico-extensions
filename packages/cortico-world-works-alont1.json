  "describe": {
    "tools": [
      {
        "name": "works_add",
        "description": "把自己的作品收进作品页：写个标题、备注，可以附一个本地文件（图/视频/网页都行）。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "description": "作品名。"
            },
            "note": {
              "type": "string",
              "description": "一句介绍，可不填。"
            },
            "path": {
              "type": "string",
              "description": "本地文件路径（图/视频/网页），可不填。"
            }
          },
          "required": [
            "title"
          ]
        },
        "tags": [
          "write"
        ],
        "summary": {
          "zh": "收一件作品",
          "en": "Add a work"
        }
      },
      {
        "name": "works_list",
        "description": "看作品页里都有什么。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "tags": [
          "read"
        ],
        "summary": {
          "zh": "列作品",
          "en": "List works"
        }
      },
      {
        "name": "works_page",
        "description": "重新生成作品页（本地 HTML），返回路径。改了作品之后调一次。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "tags": [
          "write"
        ],
        "summary": {
          "zh": "生成作品页",
          "en": "Generate works page"
        }
      }
    ],
    "events": []
  },
  "changelog": {
    "0.2.0": "- 作品产物默认使用 works 自有数据目录，保留原子保存和坏状态保护。\n- 面板保留快速交替启停的最终停止，显示执行中调用与耗时，按 failed:true 统计失败；面板代码随包内置。\n- 按 Cortico 0.2.7 的 World API 6 / Bot API 7 检查适用契约；单包产物不引入其他扩展。\n\n迁移：作品副本与页面为部署 dataDir/works；works.json 索引位置保留。旧 workspace/works 原位保留，按 README 手动复制所需文件。"
  }
}
